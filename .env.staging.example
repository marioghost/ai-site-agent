# Staging environment — used by smoke tests and as template for staging server .env
#
# On staging server, copy values to PROJECT_ROOT/.env (see deploy.staging.local.conf.example)
# For local smoke against a running staging backend:
#   cp .env.staging.example .env.staging
#   make smoke-staging

APP_ENV=staging
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL on staging host (not Docker)
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ai_site_agent_staging
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://ai_agent:CHANGE_ME@127.0.0.1:5432/ai_site_agent_staging

# Host services (systemd)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_WARMUP_ENABLED=false

DEFAULT_LLM_MODEL=qwen2.5:3b
DEFAULT_EMBEDDING_MODEL=bge-m3
DEFAULT_QDRANT_COLLECTION=site_knowledge_staging

JWT_SECRET_KEY=staging-change-me-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000

# RFC-100 flags — keep OFF unless staging test explicitly enables them
KNOWLEDGE_OS_EXECUTIVE_ENABLED=false

# Smoke script targets (this file only — not read by backend unless copied to .env)
STAGING_BASE_URL=http://127.0.0.1:8000
STAGING_ADMIN_USER=admin
STAGING_ADMIN_PASSWORD=фвьшт

# Optional smoke behaviour
# SMOKE_CHAT=1              # POST /api/chat (needs Ollama + models)
# SMOKE_EXECUTIVE=1         # test executive path after restarting with flag ON

# Migration test against disposable DB (CI or dedicated test database only):
# POSTGRES_TEST_URL=postgresql+psycopg://ai_agent:CHANGE_ME@127.0.0.1:5432/ai_site_agent_migration_test
