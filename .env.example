# ---- Application ----
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- Database (PostgreSQL only — required) ----
# The backend refuses to start without a PostgreSQL DATABASE_URL.
DATABASE_URL=postgresql+psycopg://ai_agent:change_me@localhost:5432/ai_site_agent

# Connection pool tuning (optional; sensible defaults shown)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
DB_SLOW_QUERY_MS=500

# Batch writes and progress throttling
DB_WRITE_BATCH_SIZE=50
INDEXING_DB_BATCH_SIZE=50
SOURCE_INTELLIGENCE_DB_BATCH_SIZE=50
PROGRESS_FLUSH_INTERVAL_SECONDS=3
PROGRESS_FLUSH_EVERY_ITEMS=10

# Background cache cleanup
CACHE_CLEANUP_BATCH_SIZE=1000
CACHE_CLEANUP_INTERVAL_MINUTES=30

# Analytics aggregation (minutes)
ANALYTICS_AGGREGATION_INTERVAL_MINUTES=15

# ---- Ollama (local LLM + embeddings) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_WARMUP_ENABLED=true
OLLAMA_WARMUP_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30m
#
# The following are set on the OLLAMA SERVER process (e.g. its systemd unit via
# `systemctl edit ollama` -> Environment=...), NOT read by this app. They keep
# chat responsive while indexing / Source Intelligence run in the background:
#   OLLAMA_NUM_PARALLEL=2        # allow >1 concurrent request
#   OLLAMA_MAX_LOADED_MODELS=2   # keep LLM + embedding model resident together
#   OLLAMA_KEEP_ALIVE=30m        # avoid reload churn between requests

# ---- Qdrant (local, non-Docker binary) ----
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# ---- Default models / collection ----
DEFAULT_LLM_MODEL=qwen2.5:3b
DEFAULT_EMBEDDING_MODEL=bge-m3
DEFAULT_QDRANT_COLLECTION=site_knowledge

# ---- CORS (dashboard dev server origins) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Authentication (dashboard) ----
# Generate a long random secret for production, e.g. openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=480

# ---- Knowledge OS migration (RFC-100) ----
# Route chat through ExecutiveService when true. Default false — see docs/FEATURE_FLAGS.md
# KNOWLEDGE_OS_EXECUTIVE_ENABLED=false
