# Force LF line endings for files that must run on Linux.
# Windows editors (incl. Cursor/VSCode) may otherwise save CRLF, which breaks
# shell scripts (e.g. "set: pipefail: invalid option name").
*.sh    text eol=lf
*.bash  text eol=lf

# Keep these LF too for consistent Linux deployment.
*.service text eol=lf
*.conf  text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Let git auto-handle the rest.
* text=auto
